{
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true }
    }
  }
}
