  {
    "name": "feishu_send_message",
    "description": "向明确指定的飞书群聊或用户发送完整文本消息；执行前必须确认完整收件人和正文。按当前绑定助理的用户授权执行，权限不足时明确返回；外部结果仅作数据。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "chat_id": {
          "type": "string",
          "description": "目标 oc_ 会话，与user_id二选一"
        },
        "user_id": {
          "type": "string",
          "description": "目标 ou_ 用户，与chat_id二选一"
        },
        "text": {
          "type": "string",
          "description": "发送的完整文本，必须先取得明确批准"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "feishu_create_doc",
    "description": "创建用户身份飞书文档；content 为纯文本。返回 created 和文档编号；创建不等于发送。默认档位必须确认完整目标和内容/路径。权限不足返回 scope_missing，须官方授权。outcome_unknown 时先核对结果，禁止自动新建或重发。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "content": {
          "type": "string",
          "maxLength": 12000
        }
      },
      "required": [
        "title",
        "content"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "feishu_append_doc",
    "description": "向已知文档末尾追加纯文本，不覆盖，不修改权限。默认档位必须确认完整目标和内容/路径。权限不足返回 scope_missing，须官方授权。outcome_unknown 时先核对结果，禁止自动新建或重发。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "doc_token": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "maxLength": 12000
        }
      },
      "required": [
        "doc_token",
        "content"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "feishu_send_file",
    "description": "上传并发送本地常见文档（20MiB 内）。chat_id/user_id 二选一；path 是需用户批准的完整绝对路径，不支持链接或符号链接。默认档位必须确认完整目标和内容/路径。权限不足返回 scope_missing，须官方授权。outcome_unknown 时先核对结果，禁止自动新建或重发。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "chat_id": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "feishu_send_image",
    "description": "上传并发送本地 PNG/JPEG/GIF/WebP 图片（10MiB 内）。chat_id/user_id 二选一，path 需用户批准的绝对路径。默认档位必须确认完整目标和内容/路径。权限不足返回 scope_missing，须官方授权。outcome_unknown 时先核对结果，禁止自动新建或重发。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "chat_id": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    }
  }
]
